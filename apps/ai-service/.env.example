# App
APP_ENV=development
APP_NAME=ai-service
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Database
DATABASE_URL=sqlite:///./app.db

# General chat (streaming, context-aware)
CHAT_MAX_HISTORY=10

# Companion (health companionship chat, streaming)
COMPANION_MAX_HISTORY=12

# iFlytek TTS (voice read-aloud, requires a platform app)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
IFLYTEK_TTS_VOICE=xiaoyan
IFLYTEK_TTS_SPEED=50
IFLYTEK_TTS_VOLUME=50
IFLYTEK_TTS_PITCH=50

# iFlytek Super Smart TTS (超拟人语音合成, independent of the v2 TTS)
# AUTH_METHOD: 1 = x-api-key header with APIPassword, 2 = HMAC-SHA256 signed URL
# 注意：前端 WebSocket 直连（/api/smart-tts/ws-url）只能使用 AUTH_METHOD=2
IFLYTEK_SMART_TTS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6
IFLYTEK_SMART_TTS_AUTH_METHOD=2
IFLYTEK_SMART_TTS_APP_ID=52e4a842
IFLYTEK_SMART_TTS_API_KEY=0b93f27fe80262b9d6c1f17f38f18f27
IFLYTEK_SMART_TTS_API_SECRET=ZTJiMDZmNGI0M2JkYWY2Nzk3NjhmYzFh
IFLYTEK_SMART_TTS_API_PASSWORD=ak-xrt4pKzIM2wsYklRogiM7O9ZQr0PBmjG
IFLYTEK_SMART_TTS_VOICE=x6_lingxiaoyue_pro
IFLYTEK_SMART_TTS_SPEED=50
IFLYTEK_SMART_TTS_VOLUME=50
IFLYTEK_SMART_TTS_PITCH=50
IFLYTEK_SMART_TTS_SAMPLE_RATE=24000

# Triage / RAG (Ollama + ChromaDB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=120.0

# --- LLM / Embedding backend (OpenAI-compatible, switch via env) ---
# LLM_* / EMBED_* 为空时回退到上面的 OLLAMA_*（本地开发用 Ollama，零配置）。
# 生产切换后端只需填 LLM_BASE_URL/LLM_API_KEY/LLM_MODEL（生成）与
# EMBED_BASE_URL/EMBED_API_KEY/EMBED_MODEL（嵌入），无需改代码。
#
# 示例 - 本地 Ollama（开发默认）：保持下面全部为空即可。
#
# 示例 - 自托管 vLLM（生产自建，吞吐远高于 Ollama）：
#   LLM_BASE_URL=http://10.0.0.10:8000
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   EMBED_BASE_URL=http://10.0.0.10:8000
#   EMBED_MODEL=BAAI/bge-m3
#
# 示例 - 阿里云百炼（通义）兼容模式（生产调云 API）：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_MODEL=qwen-plus
#   EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBED_API_KEY=sk-xxxxxxxx
#   EMBED_MODEL=text-embedding-v3   # 默认 1024 维，与 bge-m3 一致
#
# 注意：更换嵌入模型须同步 EMBEDDING_DIM 并清空 data/chroma 重新入库。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=0
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_TIMEOUT=0

EMBEDDING_DIM=1024
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=hospital_kb
KB_DIR=./knowledge
TRIAGE_TOP_K=4
TRIAGE_MAX_HISTORY=6
TRIAGE_CHUNK_SIZE=500
TRIAGE_CHUNK_OVERLAP=80
