# App
APP_ENV=development
APP_NAME=ai-service
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Database
DATABASE_URL=sqlite:///./app.db

# General chat (streaming, context-aware)
CHAT_MAX_HISTORY=10

# Companion (health companionship chat, streaming)
COMPANION_MAX_HISTORY=12

# iFlytek TTS (voice read-aloud, requires a platform app)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
IFLYTEK_TTS_VOICE=xiaoyan
IFLYTEK_TTS_SPEED=50
IFLYTEK_TTS_VOLUME=50
IFLYTEK_TTS_PITCH=50

# iFlytek Super Smart TTS (超拟人语音合成, independent of the v2 TTS)
# AUTH_METHOD: 1 = x-api-key header with APIPassword (default), 2 = HMAC-SHA256 signed URL
IFLYTEK_SMART_TTS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6
IFLYTEK_SMART_TTS_AUTH_METHOD=1
IFLYTEK_SMART_TTS_APP_ID=52e4a842
IFLYTEK_SMART_TTS_API_KEY=0b93f27fe80262b9d6c1f17f38f18f27
IFLYTEK_SMART_TTS_API_SECRET=ZTJiMDZmNGI0M2JkYWY2Nzk3NjhmYzFh
