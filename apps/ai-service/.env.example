IFLYTEK_SMART_TTS_VOICE=x6_lingxiaoyue_pro
IFLYTEK_SMART_TTS_SPEED=50
IFLYTEK_SMART_TTS_VOLUME=50
IFLYTEK_SMART_TTS_PITCH=50
