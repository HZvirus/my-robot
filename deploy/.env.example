# --- 通用 ---
SERVICE_NAME=my-robot
JWT_SECRET=dev-secret-change-me-please-32bytes-minimum
JWT_EXPIRE_MINUTES=1440
DEBUG=true
LOG_LEVEL=INFO

# --- 数据库 (PostgreSQL + pgvector) ---
POSTGRES_USER=myrobot
POSTGRES_PASSWORD=myrobot
POSTGRES_DB=myrobot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://myrobot:myrobot@localhost:5432/myrobot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- EMQX (MQTT / MQTT-over-WebSocket) ---
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_WS_PORT=8083
EMQX_USERNAME=myrobot
EMQX_PASSWORD=myrobot

# --- 服务端口 ---
DIALOG_ENGINE_PORT=8100
USER_TENANT_PORT=8200
MODEL_GATEWAY_PORT=8300
RAG_ENGINE_PORT=8400
TASK_EXECUTOR_PORT=8500

# --- 上游服务地址（容器内主机名） ---
MODEL_GATEWAY_URL=http://model-gateway:8300
RAG_ENGINE_URL=http://rag-engine:8400
TASK_EXECUTOR_URL=http://task-executor:8500
USER_TENANT_URL=http://user-tenant:8200

# --- LLM 适配器（可选；留空则回退 mock） ---
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Kong ---
KONG_GATEWAY_PORT=8000
KONG_ADMIN_PORT=8001

# --- 前端 dev 代理目标 ---
KONG_URL=http://localhost:8000
